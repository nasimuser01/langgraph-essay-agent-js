# LLM: Groq is used when GROQ_API_KEY is set, otherwise Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Force a provider: groq | gemini
LLM_PROVIDER=

# Search: Tavily when set (free tier at tavily.com), otherwise Wikipedia (no key).
TAVILY_API_KEY=

PORT=3000
