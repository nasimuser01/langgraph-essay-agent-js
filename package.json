{
  "name": "langgraph-essay-agent-js",
  "version": "1.1.0",
  "description": "Essay writer agent using LangGraph.js with a live-streaming React UI and Express SSE server",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "server": "node src/server.js",
    "server:dev": "node --watch src/server.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install"
  },
  "keywords": [
    "langgraph",
    "langchain",
    "agent",
    "react",
    "sse"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@tavily/core": "^0.7.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  }
}
